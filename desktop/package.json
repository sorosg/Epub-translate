{
  "name": "epub-translator-desktop",
  "version": "3.0.0",
  "description": "EPUB Fordító Rendszer – önálló asztali alkalmazás (Windows/macOS)",
  "author": "sorosg",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "hu.epubtranslator.app",
    "productName": "EPUB Fordító",
    "files": [
      "main.js",
      "backend_entry.py"
    ],
    "extraResources": [
      {
        "from": "./pybackend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../src/frontend/dist",
        "to": "frontend",
        "filter": ["**/*"]
      }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" }
  }
}