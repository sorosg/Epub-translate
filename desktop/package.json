{
  "name": "epub-translator-desktop",
  "version": "2.6.8",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "hu.epubtranslator.app",
    "productName": "EPUB Fordító",
    "files": [
      "main.js",
      "backend_entry.py",
      "../src/frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "./pybackend",
        "to": "backend",
        "filter": ["**/*", "!venv/**", "!__pycache__/**", "!*.pyc"]
      }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" }
  }
}
